{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/check_py_traps.py 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Checking for known Python traps..."
          }
        ]
      }
    ]
  }
}
