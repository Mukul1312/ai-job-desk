# remote-job-hunter — copy to .env and fill in. .env is gitignored.
#
# Two separate environments, and it matters which is which:
#
#   THIS FILE  -> the Python pipeline, running on your machine.
#   VERCEL     -> the website's /api/notes function. Those vars live in the
#                 Vercel project, NOT here. Supabase injected them when you
#                 connected the store, so there is nothing to copy across.
#
# The Postgres block at the bottom is only needed if you run `vercel dev`
# locally. The deployed site never reads this file.


# ─── Job sources ──────────────────────────────────────────────────────────

# RemoteRocketship — https://www.remoterocketship.com/api-docs
# Needs an active subscription. Sign in -> Advanced -> API access.
# Caps: 3000 jobs / 500 requests per UTC day. Skipped when unset.
REMOTEROCKETSHIP_API_KEY=

# Mindcase — https://console.mindcase.co  (credits never expire)
# Powers the EPFO "can this company employ someone in India?" lookup.
# Billed per row returned; the free India signals still run without it.
MINDCASE_API_KEY=

# Adzuna — https://developer.adzuna.com (free tier)
# Optional. AU/NZ/SG/UK listings. Skipped when unset.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# GetHired (gethired.devhub.co.in) — paid account only.
# Supabase JWT from a logged-in session. Unlocks real job descriptions,
# which the public endpoint omits. Expires ~1h; refresh when you see 401.
GETHIRED_TOKEN=


# ─── Website database (local `vercel dev` only) ───────────────────────────
#
# Production gets these from Vercel automatically. The notes function uses
# exactly ONE of them — the first it finds — and ignores the rest:
#
#   DATABASE_URL > POSTGRES_URL > POSTGRES_PRISMA_URL
#   > SUPABASE_POSTGRES_URL > POSTGRES_URL_NON_POOLING
#
# POSTGRES_URL is the pooled connection and the right one for serverless.

POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Optional shared secret for /api/notes. Without it, anyone who finds the
# deployment URL can read and write your job notes. Set it in Vercel too.
NOTES_TOKEN=

# NOT NEEDED by this project — do not paste them here.
#   SUPABASE_SERVICE_ROLE_KEY   full admin, bypasses row-level security
#   SUPABASE_JWT_SECRET         signs auth tokens
#   SUPABASE_ANON_KEY / URL     browser-side Supabase SDK, unused here
# The notes function connects over plain Postgres and needs none of them.
