# ---------------------------------------------------------------------------
# Personal career material. THIS REMOTE IS PUBLIC (github.com/Mukul1312/ai-job-desk),
# so these stay out of it. Added 2026-11-08 after an audit found nothing was
# stopping `git add .` from publishing them.
#
# They are NOT disposable - facts/ is 83 verified facts that took a full session
# to build and exists on one disk only. Back them up to a SEPARATE PRIVATE repo,
# the same way data/ is handled. See docs/INTEGRATION-PLAN-CRITIQUE.md item 4.
# ---------------------------------------------------------------------------

# Verified work history. Names colleagues, records whose work is whose, and
# carries _DO_NOT_CLAIM / know_before_claiming notes never meant to be read by
# anyone but you.
facts/

# Interview prep. Concept cards quote the same colleague attributions.
prep/

# Session notes, decisions and the integration plan. Name colleagues, the
# employer, and the open questions on specific resume claims.
docs/

# Self-rated skill levels (117 skills, including the ones rated 'Critical gap').
config/skill_demand.json

tools/__pycache__/

# Cover letters and per-application notes. Personal, and some quote facts that
# are private. Backed up by tools/backup_private.py.
applications/

# Captured job-posting text. Third-party copyrighted content - the manifest
# records every URL so tools/capture_jd.py can re-fetch it, but the text itself
# is not republished here.
tests/jd_extraction/cases/*.txt

# Held-out posting text: third-party copyrighted content. MANIFEST.json and
# labels/ are kept - they are our measurements, with short quotes.
tests/heldout/cases/*.txt
