{
  "remotive": {
    "enabled": true,
    "type": "api",
    "base_url": "https://remotive.com/api/remote-jobs",
    "category_map": {
      "ai-ml": "ai-ml",
      "qa-automation": "qa",
      "software-dev": "software-development",
      "devops": "devops"
    },
    "cache_hours": 0
  },
  "remoteok": {
    "enabled": true,
    "type": "api",
    "base_url": "https://remoteok.com/api",
    "filter_mode": "client-side-phrases",
    "cache_hours": 0
  },
  "jobicy": {
    "enabled": true,
    "type": "api",
    "base_url": "https://jobicy.com/api/v2/remote-jobs",
    "tag_map": {
      "ai-ml": [
        "machine-learning",
        "ai",
        "data-science",
        "nlp",
        "deep-learning",
        "llm"
      ],
      "qa-automation": [
